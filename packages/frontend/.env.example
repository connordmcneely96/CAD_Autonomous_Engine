# Clerk Authentication
# Get these from https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects

# API Endpoints
# Cloudflare Workers Backend
NEXT_PUBLIC_API_URL=http://localhost:8787
# Optional legacy endpoints
NEXT_PUBLIC_CAD_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001

# App Configuration
NEXT_PUBLIC_APP_NAME="CAD Autonomous Engine"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_3D_VIEWER=true
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
