{
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @cad-engine/frontend build",
  "outputDirectory": "packages/frontend/.next",
  "devCommand": "cd packages/frontend && pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "https://your-backend-api.railway.app/:path*"
    },
    {
      "source": "/api/cad/:path*",
      "destination": "https://your-cad-engine.railway.app/:path*"
    },
    {
      "source": "/api/ai/:path*",
      "destination": "https://your-ai-service.railway.app/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://your-backend-api.railway.app",
    "NEXT_PUBLIC_CAD_ENGINE_URL": "https://your-cad-engine.railway.app",
    "NEXT_PUBLIC_AI_SERVICE_URL": "https://your-ai-service.railway.app"
  }
}
