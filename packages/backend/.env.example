# Cloudflare Workers Backend Configuration
# ==============================================================================
# This backend runs on Cloudflare Workers with Hono framework
# Configuration is primarily done through wrangler.toml

# Environment Variables
# ----------------------
# Most configuration is in wrangler.toml [vars] section
# Secrets are set using: wrangler secret put SECRET_NAME

# Clerk Authentication
# ----------------------
# Set these as secrets (DO NOT commit actual values):
# wrangler secret put CLERK_PUBLISHABLE_KEY
# wrangler secret put CLERK_SECRET_KEY
#
# CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Bindings (configured in wrangler.toml)
# --------------------------------------------------
# DB - D1 Database binding
# STORAGE - R2 Bucket binding
# ENVIRONMENT - Set in [vars] section

# Local Development
# -----------------
# For local development with wrangler dev:
# wrangler dev --local

# The following services are accessed via bindings:
# - Database: c.env.DB (D1)
# - Storage: c.env.STORAGE (R2)
# - Secrets: c.env.CLERK_PUBLISHABLE_KEY, c.env.CLERK_SECRET_KEY

# CORS Configuration
# ------------------
# CORS origins are configured in src/index.ts
# Update the allowed origins list for your frontend URLs

# Note: Never commit secrets to version control!
# Use wrangler secrets for sensitive data
