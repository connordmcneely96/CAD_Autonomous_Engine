{
  "name": "@cad-engine/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist node_modules",
    "db:create": "wrangler d1 create cad-engine-db",
    "db:execute": "wrangler d1 execute cad-engine-db --file=./schema.sql",
    "db:query": "wrangler d1 execute cad-engine-db --command",
    "r2:create": "wrangler r2 bucket create cad-engine-files"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/env": "^4.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.13.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@hono/clerk-auth": "^2.0.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.81.1",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "hono": "^4.4.11",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^6.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@cloudflare/workers-types": "^4.20241011.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "wrangler": "^3.79.0"
  }
}
