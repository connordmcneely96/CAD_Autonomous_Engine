# Server Configuration
PORT=8100
NODE_ENV=development
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8001

# API Security
API_KEY=your_api_key_here
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Engineering Constants
GRAVITY=386.4
# inches/sec² (US customary units)

# Material Database Connection (optional - for future integration)
MATERIALS_DB_URL=postgresql://localhost:5432/materials
