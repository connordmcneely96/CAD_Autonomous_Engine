  "version": 2,
  "buildCommand": "cd packages/frontend && pnpm build",
  "devCommand": "cd packages/frontend && pnpm dev",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "packages/frontend/.next",
