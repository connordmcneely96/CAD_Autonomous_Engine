{
  "name": "cad-autonomous-engine",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered CAD SaaS platform",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:frontend": "pnpm --filter @cad-engine/frontend dev",
    "dev:backend": "pnpm --filter @cad-engine/backend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @cad-engine/frontend build",
    "build:backend": "pnpm --filter @cad-engine/backend build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.1.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0"
}
